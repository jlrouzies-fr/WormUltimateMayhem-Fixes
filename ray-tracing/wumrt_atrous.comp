#version 430
// One filter pass over the indirect light. It runs several times, each time reaching twice
// as far (uStep = 1, 2, 4, ...) with the same 25 samples, so the blur gets wide at little
// cost. A neighbour counts less the more its brightness differs from this pixel's, measured
// against the variance still left in the pixel: where much noise remains everything nearby
// is averaged, where the light has settled its detail is kept. Neighbours on another
// surface (different normal, off this pixel's plane) do not count at all. The variance is
// filtered along, so each pass knows how much the one before it achieved.
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 1) uniform readonly image2D uSrc;     // sun visibility, distance, normal (this frame)
layout(rgba16f, binding = 2) uniform readonly image2D uIn;      // rgb = indirect light, a = variance
layout(rgba16f, binding = 0) uniform writeonly image2D uOut;

uniform vec3 uEye, uBase, uDx, uDy;     // ray through pixel (x, y): uBase + x*uDx + y*uDy - uEye
uniform int uStep;                      // distance between samples, in pixels

const float FAR = 60000.0;
const vec3 LUM = vec3(0.3, 0.59, 0.11);
const float KERNEL[3] = float[3](0.375, 0.25, 0.0625);

vec3 octDecode(vec2 e)
{
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 pointAt(ivec2 p, float t)
{
    return uEye + normalize(uBase + uDx * float(p.x) + uDy * float(p.y) - uEye) * t;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOut);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec4 g = imageLoad(uSrc, pix);
    vec4 c = imageLoad(uIn, pix);
    if (g.y >= FAR - 1.0) {
        imageStore(uOut, pix, vec4(0.0));
        return;
    }
    vec3 nc = octDecode(g.zw);
    vec3 pc = pointAt(pix, g.y);
    float tol = 0.004 * g.y + 0.03;
    float lc = dot(c.rgb, LUM);
    float sigma = 3.0 * sqrt(max(c.a, 0.0)) + 0.01 * lc + 1e-4;
    vec3 sum = c.rgb * (KERNEL[0] * KERNEL[0]);
    float vsum = c.a * (KERNEL[0] * KERNEL[0]) * (KERNEL[0] * KERNEL[0]);
    float wsum = KERNEL[0] * KERNEL[0];
    for (int dy = -2; dy <= 2; dy++)
        for (int dx = -2; dx <= 2; dx++) {
            if (dx == 0 && dy == 0) continue;
            ivec2 q = pix + ivec2(dx, dy) * uStep;
            if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y) continue;
            vec4 s = imageLoad(uSrc, q);
            if (s.y >= FAR - 1.0) continue;
            // Neighbouring triangles of a curved surface count too (their normals differ a little);
            // the plane test below still keeps other surfaces out.
            if (dot(octDecode(s.zw), nc) < 0.7) continue;
            if (abs(dot(pointAt(q, s.y) - pc, nc)) > tol) continue;
            vec4 v = imageLoad(uIn, q);
            float w = KERNEL[abs(dx)] * KERNEL[abs(dy)] * exp(-abs(dot(v.rgb, LUM) - lc) / sigma);
            sum += v.rgb * w;
            vsum += v.a * w * w;
            wsum += w;
        }
    imageStore(uOut, pix, vec4(sum / wsum, vsum / (wsum * wsum)));
}
