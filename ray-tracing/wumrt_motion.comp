#version 430
// Camera motion blur (motion.c): a film shutter's smear along the camera's motion, on the
// game's scene texture right after the lit scene (post.c, at the depth of field's place, so
// particles, name labels and the HUD drawn later stay sharp). Every loop has a constant bound.
//
// PASS 1 VEL     mask (eye distance) + this and last frame's camera -> vel image:
//                xy blur vector in pixels (shutter-scaled, clamped), z eye distance, w 1 = the
//                surface moved by itself (it was not there last frame), so it is not smeared
// PASS 2 GATHER  scene + vel -> tmp: box-shutter average of up to 16 taps along the pixel's own
//                blur vector; a nearer tap only counts if its own smear reaches this pixel
//                (so the foreground does not bleed onto the background behind it)
// PASS 3 STORE   tmp -> scene texture (OUT_RGBA8 for an 8-bit scene texture)
//
// The scene texture holds sRGB-encoded colour (RGBA16F with hdr = 1, may go above 1).

#ifndef PASS
#define PASS 2
#endif
layout(local_size_x = 8, local_size_y = 8) in;

uniform vec4 uView;        // viewport width, height (scene pixels), mask width, height
uniform vec4 uBlur;        // shutter fraction, largest blur in pixels, taps (<= 16), prev mask valid (1/0)
uniform vec4 uFrame;       // frame number, 1 = smear only the right half (A/B check), -, -
uniform mat4 uVP;          // this frame's view * projection
uniform mat4 uPrevVP;      // last frame's
uniform vec3 uEye;         // this frame's eye (world)
uniform vec3 uPrevEye;
uniform vec3 uBase;        // ray direction at uv (0, 0); + u * uDx + v * uDy (not normalised)
uniform vec3 uDx;
uniform vec3 uDy;

const float FAR = 60000.0;

vec3 toLinear(vec3 c) { return pow(max(c, vec3(0.0)), vec3(2.2)); }
vec3 toGamma(vec3 c) { return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2)); }

#if PASS == 1
layout(binding = 0) uniform sampler2D uMaskTex;
layout(binding = 1) uniform sampler2D uPrevMaskTex;
layout(rgba16f, binding = 0) uniform writeonly image2D uVel;

vec2 project(mat4 m, vec4 p, out bool ok)
{
    vec4 c = m * p;
    ok = c.w > 1e-4;
    return ok ? c.xy / c.w * 0.5 + 0.5 : vec2(0.0);
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(uView.x) || pix.y >= int(uView.y)) return;
    vec2 uv = (vec2(pix) + 0.5) / uView.xy;
    ivec2 m = clamp(ivec2(uv * uView.zw), ivec2(0), ivec2(uView.zw) - 1);
    float d = texelFetch(uMaskTex, m, 0).y;
    bool sky = d <= 0.0 || d >= FAR * 0.9;
    vec3 dir = normalize(uBase + uv.x * uDx + uv.y * uDy);
    // A surface point (or, for the sky, a direction: only the camera's turn moves it).
    vec4 p = sky ? vec4(dir, 0.0) : vec4(uEye + dir * d, 1.0);
    bool ok0, ok1;
    // Both ends projected from the same point, so a camera that holds still gives exactly 0.
    vec2 now = project(uVP, p, ok0);
    vec2 was = project(uPrevVP, p, ok1);
    vec2 v = ok0 && ok1 ? (now - was) * uView.xy * uBlur.x : vec2(0.0);
    float moved = 0.0;
    if (!sky && ok1 && uBlur.w > 0.5 && all(greaterThan(was, vec2(0.0))) && all(lessThan(was, vec2(1.0)))) {
        // Where a still point would have been last frame: if something farther was there in
        // all four nearest mask texels, this surface moved (a worm or shell the camera follows).
        float expect = length(p.xyz - uPrevEye);
        float tol = 0.03 * expect + 1.0;
        vec2 q = was * uView.zw - 0.5;
        ivec2 b = ivec2(floor(q));
        float nearest = FAR;
        for (int j = 0; j < 2; j++)
            for (int i = 0; i < 2; i++) {
                ivec2 t = clamp(b + ivec2(i, j), ivec2(0), ivec2(uView.zw) - 1);
                float pd = texelFetch(uPrevMaskTex, t, 0).y;
                nearest = min(nearest, pd <= 0.0 ? FAR : pd);
            }
        if (nearest > expect + tol) moved = 1.0;
    }
    if (moved > 0.5) v = vec2(0.0);
    float len = length(v);
    if (len > uBlur.y) v *= uBlur.y / len;
    if (len < 0.35) v = vec2(0.0);
    imageStore(uVel, pix, vec4(v, sky ? FAR : d, moved));
}
#endif

#if PASS == 2
layout(binding = 0) uniform sampler2D uScene;
layout(rgba16f, binding = 1) uniform readonly image2D uVelImg;
layout(rgba16f, binding = 0) uniform writeonly image2D uTmp;

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(uView.xy);
    if (pix.x >= size.x || pix.y >= size.y) return;
    vec4 self = texelFetch(uScene, pix, 0);
    vec4 vx = imageLoad(uVelImg, pix);
    float lx = length(vx.xy);
    if (lx < 0.35) { imageStore(uTmp, pix, self); return; }
    int n = int(clamp(uBlur.z, 2.0, 16.0));
    // interleaved gradient noise: spreads the taps' positions so the few taps do not band
    float jit = fract(52.9829189 * fract(dot(vec2(pix) + float(int(uFrame.x) & 7) * 5.588238, vec2(0.06711056, 0.00583715)))) - 0.5;
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 16; i++) {
        if (i >= n) break;
        float s = (float(i) + 0.5 + jit) / float(n) - 0.5;      // -0.5 .. 0.5 of the shutter
        ivec2 q = clamp(ivec2(floor(vec2(pix) + 0.5 + vx.xy * s)), ivec2(0), size - 1);
        vec4 vy = imageLoad(uVelImg, q);
        float off = abs(s) * lx;                                 // pixels from this one
        // a tap nearer to the camera than this pixel counts only where its own smear reaches here
        float front = clamp((vx.z - vy.z) / (0.05 * vx.z + 2.0), 0.0, 1.0);
        float reach = clamp(0.5 * length(vy.xy) - off + 0.5, 0.0, 1.0);
        float w = mix(1.0, reach, front);
        sum += toLinear(texelFetch(uScene, q, 0).rgb) * w;
        wsum += w;
    }
    vec3 c = wsum > 1e-3 ? toGamma(sum / wsum) : self.rgb;
    imageStore(uTmp, pix, vec4(c, self.a));
}
#endif

#if PASS == 3
layout(rgba16f, binding = 1) uniform readonly image2D uTmpImg;
layout(rgba16f, binding = 2) uniform readonly image2D uVelImg;
#ifdef OUT_RGBA8
layout(rgba8, binding = 0) uniform writeonly image2D uOut;
#else
layout(rgba16f, binding = 0) uniform writeonly image2D uOut;
#endif

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(uView.x) || pix.y >= int(uView.y)) return;
    if (length(imageLoad(uVelImg, pix).xy) < 0.35) return;     // not smeared: left exactly as it was
    if (uFrame.y > 0.5 && pix.x < int(uView.x) / 2) return;
    imageStore(uOut, pix, imageLoad(uTmpImg, pix));
}
#endif
